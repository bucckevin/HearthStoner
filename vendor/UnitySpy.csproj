<Project Sdk="Microsoft.NET.Sdk">
  <!-- UnitySpy + UnitySpy.HearthstoneLib (MIT), vendored from https://github.com/Zero-to-Heroes/unity-spy-.net4.5
       (commit in UNITYSPY_COMMIT.txt). Reads Hearthstone's Mono memory read-only. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>HackF5.UnitySpy</RootNamespace>
    <AssemblyName>UnitySpy</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0168;CS0169;CS0219;CS0414;CS0649;CS0162;CS0618;CS1998;CS8632;CS0108;CS0114;CS0105;CA1416;SYSLIB0011;SYSLIB0014;CS0659</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UnitySpy/**/*.cs;UnitySpy.HearthstoneLib/**/*.cs" Exclude="**/Properties/AssemblyInfo.cs;**/obj/**;**/bin/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- HearthStoner reads through some of the library's internal readers directly. -->
    <InternalsVisibleTo Include="HearthStoner.Core" />
    <InternalsVisibleTo Include="HearthStoner" />
    <InternalsVisibleTo Include="HsTest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2019.1.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>
