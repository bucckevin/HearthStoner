<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything that isn't UI: log parsing, game tracking, advice, meta stats, deck codes, stats, memory reads.
       Plain .NET 10, so it builds and its tests run on any OS. Every .cs file in this folder is part of it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>HearthStoner</RootNamespace>
    <AssemblyName>HearthStoner.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HearthStoner" />
    <InternalsVisibleTo Include="HsTest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../vendor/UnitySpy.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
