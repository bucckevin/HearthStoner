<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Windows app: commands (Program.cs), the in-game overlay (WPF, built in code) and the tray app.
    The logic is in Core/HearthStoner.Core.csproj, memory reading in vendor/UnitySpy.csproj (MIT, from the
    Firestone team's https://github.com/Zero-to-Heroes/unity-spy-.net4.5), tests in tests/HsTest.
    Build everything with: dotnet build HearthStoner.slnx -c Release
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the app build (not run) on Linux too, so changes can be compile-checked anywhere. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>HearthStoner</RootNamespace>
    <AssemblyName>HearthStoner</AssemblyName>
    <!-- The version (major.minor.patch) lives in the VERSION file; bump it with each release and add a CHANGELOG entry.
         The SDK appends the git commit ("1.2.3+sha"); the build time is stamped below. Shown on the Settings page, in
         the tray menu, by 'HearthStoner version', in Windows' installed apps list and in hearthstoner.log. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
    <!-- Hearthstone is 64-bit; reading its memory needs a 64-bit reader. -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- exe at bin\Release\net10.0-windows\HearthStoner.exe -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The mana crystal icon (sources: App/icon.svg for 48 px and up, App/icon-small.svg for 16-32 px). -->
    <ApplicationIcon>App\hearthstoner.ico</ApplicationIcon>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <!-- Every .cs file here except the other projects' folders (Program.cs, App/, Art/, Overlay/). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Core/**;vendor/**;tests/**;screenshots/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <!-- Read back by AppVersion (Core/AppVersion.cs). -->
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::Now.ToString('yyyy-MM-ddTHH:mm'))" />
    <!-- Barlow and Barlow Condensed (SIL Open Font License, App/Fonts/OFL-Barlow.txt), built into the exe. -->
    <Resource Include="App/Fonts/*.ttf" />
    <Resource Include="App/hearthstoner.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Core/HearthStoner.Core.csproj" />
    <ProjectReference Include="vendor/UnitySpy.csproj" />
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
